# Broker Service Configuration

# Server Settings
BROKER_PORT=8081

# JWT Settings
JWT_EXPIRY=10m
JWT_ISSUER=broker-service

# Application
APP_VERSION=1.0.0

# Plugin Persistence
PLUGINS_PERSIST_PATH=data/plugins.json

# Proxy Settings
# Timeout for requests to plugins (default: 30s)
PROXY_TIMEOUT=30s

# Database Configuration (PostgreSQL)
# Format: postgres://username:password@host:port/database?sslmode=disable
# Leave empty to disable database persistence
DATABASE_URL=postgres://broker:broker123@localhost:5432/broker_db?sslmode=disable

# Example for local development:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/broker_db?sslmode=disable

# Example for production with SSL:
# DATABASE_URL=postgres://user:password@db.example.com:5432/broker_db?sslmode=require
